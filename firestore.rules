rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { 
      return request.auth != null && request.auth.uid != null; 
    }
    
    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); 
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ramonbelem1@gmail.com' ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'ADMIN') ||
        !exists(/databases/$(database)/documents/groups/main)
      );
    }

    function isApproved() {
      return isAdmin() || (
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.approved == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Collections ---

    // Connection Test
    match /test/connection {
      allow get: if isSignedIn();
    }

    // User Roles
    match /user_roles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    function isValidPlayer(data) {
      return data.displayName is string && data.displayName.size() <= 15
          && data.fullName is string && data.fullName.size() <= 100;
    }

    match /players/{playerId} {
      allow read: if isApproved() || isOwner(playerId);
      allow create: if isApproved() && isValidPlayer(incoming());
      allow update: if isAdmin() || (
        isOwner(playerId) && isApproved() && isValidPlayer(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'displayName', 'fullName', 'email', 'position', 'secondaryPosition', 'photoUrl', 'updatedAt', 'active'])
      );
      allow delete: if isAdmin();
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isApproved();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isApproved() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['confirmedIds', 'absentIds', 'waitingIds'])
      );
      allow delete: if isAdmin();
      
      // Games subcollection (Live games)
      match /games/{gameId} {
        allow read: if isApproved();
        allow write, delete: if isAdmin();
      }
    }

    // Transactions - Restricted to Admins as requested
    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }

    // Groups / Config
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Awards (Destaques)
    match /awards/{awardId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Evaluations
    function isValidEvaluation(data) {
      return data.matchId is string && data.matchId.size() <= 128
          && data.evaluatorId is string && data.evaluatorId.size() <= 128
          && data.targetId is string && data.targetId.size() <= 128
          && data.technical is number && data.technical >= 1 && data.technical <= 5
          && data.effort is number && data.effort >= 1 && data.effort <= 5
          && data.fairplay is number && data.fairplay >= 1 && data.fairplay <= 5;
    }

    match /evaluations/{evalId} {
      // Evaluations can be read by approved users (for highlights) or the target player
      allow read: if isApproved();
      // Users can only create evaluations for others (cannot evaluate themselves as per UI intended logic)
      // And we verify the evaluatorId matches the auth UID
      allow create: if isApproved() && isValidEvaluation(incoming()) && incoming().evaluatorId == request.auth.uid;
      // Evaluations should generally be immutable or only editable by admins
      allow update, delete: if isAdmin();
    }
  }
}
