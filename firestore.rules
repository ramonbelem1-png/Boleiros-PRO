rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { 
      return request.auth != null && request.auth.uid != null; 
    }
    
    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); 
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ramonbelem1@gmail.com' ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'ADMIN') ||
        !exists(/databases/$(database)/documents/groups/main)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Collections ---

    // Connection Test
    match /test/connection {
      allow get: if isSignedIn();
    }

    // User Roles
    match /user_roles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isVerified() && userId == request.auth.uid && incoming().role == 'USER';
      allow create: if isAdmin() && userId == request.auth.uid; // Admin can create themselves
      allow update: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if (request.auth.token.email == 'ramonbelem1@gmail.com') || isAdmin() || (
        isOwner(playerId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'position', 'secondaryPosition', 'photoUrl', 'updatedAt'])
      );
      allow delete: if (request.auth.token.email == 'ramonbelem1@gmail.com') || isAdmin();
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['confirmedIds', 'absentIds', 'waitingIds'])
      );
      
      // Games subcollection (Live games)
      match /games/{gameId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Transactions - Restricted to Admins as requested
    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }

    // Groups / Config
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Awards (Destaques)
    match /awards/{awardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
